#!/bin/sh

set -e

umask 077

PATH="$HOME/src/bin:$HOME/.local/bin:$HOME/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

usage() {
    printf "Usage: %s [-d \e[4mdatabase\e[0m] [-o \e[4morganization\e[0m]...]\n" "$(basename "$0")" >&2
    printf "  -d \e[4mdatabase\e[0m      SQLite database path\n" >&2
    printf "  -o \e[4morganization\e[0m  GitHub organization to poll (repeatable); default is every organization in ~/.panboticon/etc/github-app/installations.json\n" >&2
    exit "$1"
}

DATABASE="${XDG_STATE_HOME:-$HOME/.local/state}/rbotley/github.sqlite3"
ORGANIZATIONS=""
while [ "$#" -gt 0 ]
do
    case "$1" in

        "-d"|"--database") DATABASE="$2" shift 2;;
        "-d"*) DATABASE="$(echo "$1" | cut -c"3-")" shift;;
        "--database="*) DATABASE="$(echo "$1" | cut -d"=" -f"2-")" shift;;

        "-o"|"--organization") ORGANIZATIONS="$ORGANIZATIONS $2" shift 2;;
        "-o"*) ORGANIZATIONS="$ORGANIZATIONS $(echo "$1" | cut -c"3-")" shift;;
        "--organization="*) ORGANIZATIONS="$ORGANIZATIONS $(echo "$1" | cut -d"=" -f"2-")" shift;;

        "-h"|"--help") usage 0;;

        *) usage 1;;

    esac
done

command -v curl >/dev/null
command -v jq >/dev/null
command -v pi >/dev/null
command -v sqlite3 >/dev/null
command -v tmux >/dev/null

TMP="$(mktemp -d)"
trap "rm -f -r \"$TMP\"" EXIT

mkdir -p "$(dirname "$DATABASE")"
sqlite3 "$DATABASE" 'CREATE TABLE IF NOT EXISTS findings (key TEXT PRIMARY KEY, found_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);'

BOT_LOGIN="${BOT_LOGIN:-rbotley[bot]}"

QUERY='query($endCursor:String,$searchQuery:String!){search(query:$searchQuery,type:ISSUE,first:100,after:$endCursor){nodes{... on Issue{id title body url repository{nameWithOwner}} ... on PullRequest{id title body url repository{nameWithOwner} commits(last:1){nodes{commit{oid statusCheckRollup{state}}}}}} pageInfo{hasNextPage endCursor}}}'

github_graphql() {
    SEARCH_QUERY="$1" OUTPUT="$2"
    CURSOR="" PAGE="0"
    : >"$OUTPUT" || return 1
    while :
    do
        PAGE="$((PAGE + 1))"
        jq \
            --arg endCursor "$CURSOR" \
            --arg query "$QUERY" \
            --arg searchQuery "$SEARCH_QUERY" \
            -n \
            '{
                query: $query,
                variables: {
                    endCursor: (if $endCursor == "" then null else $endCursor end),
                    searchQuery: $searchQuery
                }
            }' >"$TMP/graphql-$PAGE.req.json" || return 1
        if ! curl \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer $GH_TOKEN" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            -X "POST" \
            -d @"$TMP/graphql-$PAGE.req.json" \
            -f -s \
            "https://api.github.com/graphql" >"$TMP/graphql-$PAGE.resp.json"
        then
            echo "failed to query the GitHub API" >&2
            cat "$TMP/graphql-$PAGE.resp.json" >&2
            return 1
        fi
        cat "$TMP/graphql-$PAGE.resp.json" >>"$OUTPUT" || return 1
        printf "\n" >>"$OUTPUT" || return 1
        HAS_NEXT_PAGE="$(jq -r '.data.search.pageInfo.hasNextPage' "$TMP/graphql-$PAGE.resp.json")" || return 1
        if [ "$HAS_NEXT_PAGE" != "true" ]
        then break
        fi
        CURSOR="$(jq -r '.data.search.pageInfo.endCursor' "$TMP/graphql-$PAGE.resp.json")" || return 1
    done
}

github_token() {
    if [ -n "$GH_TOKEN" ]
    then
        printf "%s\n" "$GH_TOKEN"
        return
    fi
    printf "protocol=https\nhost=github.com\nusername=x-access-token\npath=%s/x.git\n\n" "$1" |
    "$HOME/.panboticon/bin/git-credential-helper" "get" |
    sed -n "s/^password=//p"
}

process_response() {
    RESPONSE="$1" FILTER="$2" OUTPUT="$3"
    jq -c 'select(.data.search == null) | {errors}' "$RESPONSE" >"$TMP/errors-fatal.jsonl" || return 1
    if [ -s "$TMP/errors-fatal.jsonl" ]
    then
        cat "$TMP/errors-fatal.jsonl" >&2
        return 1
    fi
    jq -c 'select(.errors != null) | .errors | map({type, message})' "$RESPONSE" >&2 || return 1
    jq -c "$FILTER" "$RESPONSE" >"$OUTPUT"
}

shell_quote() {
    printf "'%s'" "$(printf "%s" "$1" | sed "s/'/'\\\\''/g")"
}

window_name() {
    printf "%s\n" "$1" |
    tr '[:upper:]' '[:lower:]' |
    tr -cs '[:alnum:]' '\n' |
    awk '
        NF && count < 4 {
            words[++count] = $1
        }
        END {
            if (count == 0) {
                words[++count] = "new"
            }
            if (count == 1) {
                words[++count] = "finding"
            }
            for (i = 1; i <= count; i++) {
                printf "%s%s", i == 1 ? "" : "-", words[i]
            }
            printf "\n"
        }
    '
}

launch() {
    KEY="$1" TITLE="$2" TEXT="$3"
    SQL_KEY="$(printf "%s" "$KEY" | sed "s/'/''/g")"
    INSERTED="$(sqlite3 "$DATABASE" "INSERT OR IGNORE INTO findings (key) VALUES ('$SQL_KEY'); SELECT changes();")"
    if [ "$INSERTED" != "1" ]
    then return
    fi

    echo
    echo
    echo
    echo "$TEXT"
    return # XXX

    PROMPT_FILE="$(mktemp "$DATABASE.prompt.XXXXXX")"
    LAUNCHER="$PROMPT_FILE.sh"
    printf "TODO PREAMBLE\n\n%s\n\nTODO OUTPUT INSTRUCTIONS.\n" "$TEXT" >"$PROMPT_FILE"
    printf "Say hello.\n" >"$PROMPT_FILE" # XXX
    printf '%s\n' '#!/bin/sh' >"$LAUNCHER"
    printf 'PROMPT="$(cat %s)"\n' "$(shell_quote "$PROMPT_FILE")" >>"$LAUNCHER"
    printf 'rm -f %s %s\n' "$(shell_quote "$PROMPT_FILE")" "$(shell_quote "$LAUNCHER")" >>"$LAUNCHER"
    printf 'exec pi -p "$PROMPT"\n' >>"$LAUNCHER"
    chmod 700 "$LAUNCHER"
    NAME="$(window_name "$TITLE")"
    COMMAND="$(shell_quote "$LAUNCHER")"
    if tmux has-session -t "auto" 2>/dev/null
    then
        if ! tmux new-window -d -n "$NAME" -t "auto:" "$COMMAND"
        then sqlite3 "$DATABASE" "DELETE FROM findings WHERE key = '$SQL_KEY';"; return 1
        fi
    elif ! tmux new-session -d -s "auto" -n "$NAME" "$COMMAND"
    then
        if ! tmux new-window -d -n "$NAME" -t "auto:" "$COMMAND"
        then sqlite3 "$DATABASE" "DELETE FROM findings WHERE key = '$SQL_KEY';"; return 1
        fi
    fi
}

poll() {
    PREFIX="$1"
    GH_TOKEN="$(github_token "$PREFIX")"
    if [ -z "$GH_TOKEN" ]
    then
        echo "failed to get a GitHub token for $PREFIX" >&2
        return 1
    fi

    github_graphql "is:issue is:open assignee:\"$BOT_LOGIN\"" "$TMP/$PREFIX-assigned-issues-response.jsonl" || return 1
    process_response "$TMP/$PREFIX-assigned-issues-response.jsonl" '.data.search.nodes[] | select(.id != null) | {key:("github:assigned-issue:" + .id),title:.title,text:("GitHub issue assigned to rbotley[bot]\nRepository: " + .repository.nameWithOwner + "\nURL: " + .url + "\nTitle: " + .title + "\n\n" + (.body // ""))}' "$TMP/$PREFIX-assigned-issues.jsonl" || return 1

    github_graphql "is:pr is:open author:\"$BOT_LOGIN\"" "$TMP/$PREFIX-passing-pull-requests-response.jsonl" || return 1
    process_response "$TMP/$PREFIX-passing-pull-requests-response.jsonl" '.data.search.nodes[] | select(.id != null and .commits.nodes[0].commit.statusCheckRollup.state == "SUCCESS") | {key:("github:passing-pull-request:" + .id + ":" + .commits.nodes[0].commit.oid),title:.title,text:("GitHub pull request opened by rbotley[bot] has all status checks passing\nRepository: " + .repository.nameWithOwner + "\nURL: " + .url + "\nTitle: " + .title + "\n\n" + (.body // ""))}' "$TMP/$PREFIX-passing-pull-requests.jsonl" || return 1

    github_graphql "is:pr is:open review-requested:\"$BOT_LOGIN\"" "$TMP/$PREFIX-review-requests-response.jsonl" || return 1
    process_response "$TMP/$PREFIX-review-requests-response.jsonl" '.data.search.nodes[] | select(.id != null) | {key:("github:review-request:" + .id),title:.title,text:("GitHub pull request assigned to rbotley[bot] for review\nRepository: " + .repository.nameWithOwner + "\nURL: " + .url + "\nTitle: " + .title + "\n\n" + (.body // ""))}' "$TMP/$PREFIX-review-requests.jsonl" || return 1

    for FILE in "$TMP/$PREFIX-assigned-issues.jsonl" "$TMP/$PREFIX-passing-pull-requests.jsonl" "$TMP/$PREFIX-review-requests.jsonl"
    do
        while IFS= read -r FINDING
        do
            KEY="$(printf "%s" "$FINDING" | jq -e -r '.key')" || return 1
            TITLE="$(printf "%s" "$FINDING" | jq -e -r '.title')" || return 1
            TEXT="$(printf "%s" "$FINDING" | jq -e -r '.text')" || return 1
            launch "$KEY" "$TITLE" "$TEXT" || return 1
        done <"$FILE"
    done
}

if [ -n "$GH_TOKEN" ]
then
    poll "x"
else
    if [ -z "$ORGANIZATIONS" ]
    then ORGANIZATIONS=" $(jq -e -r '.[].ORGANIZATION' "$HOME/.panboticon/etc/github-app/installations.json")"
    fi
    FAILED=""
    for ORGANIZATION in $ORGANIZATIONS
    do
        if ! ( poll "$ORGANIZATION" )
        then
            echo "failed to poll $ORGANIZATION" >&2
            FAILED="yes"
        fi
    done
    [ -z "$FAILED" ]
fi
