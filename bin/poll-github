#!/bin/sh

set -e

usage() {
    printf "Usage: %s [-q \e[4mquery\e[0m] [-s \e[4msince\e[0m]\n" "$(basename "$0")" >&2
    printf "  -q \e[4mquery\e[0m  search query; prefix with \"@\" for an app or user; additionally suffix with \"[bot]\" for an app\n" >&2
    printf "  -s \e[4msince\e[0m  absolute or relative timestamp (default \"24 hours ago\")\n" >&2
    exit "$1"
}

QUERY="" SINCE="24 hours ago"
while [ "$#" -gt 0 ]
do
    case "$1" in

        "-q"|"--query") QUERY="$2" shift 2;;
        "-q"*) QUERY="$(echo "$1" | cut -c"3-")" shift;;
        "--query="*) QUERY="$(echo "$1" | cut -d"=" -f"2-")" shift;;

        "-s"|"--since") SINCE="$2" shift 2;;
        "-s"*) SINCE="$(echo "$1" | cut -c"3-")" shift;;
        "--since="*) SINCE="$(echo "$1" | cut -d"=" -f"2-")" shift;;

        "-h"|"--help") usage 0;;

        *) usage 1;;

    esac
done
if [ -z "$QUERY" ]
then usage 1
fi

SINCE_DATE=">=$(date -d "$SINCE" -u +"%Y-%m-%d")"

TMP="$(mktemp -d)"
trap "rm -f -r \"$TMP\"" EXIT

if echo "$QUERY" | grep -q "^@"
then gh search issues \
    --include-prs \
    --involves "$QUERY" \
    --json "repository,title,url,state,number,updatedAt" \
    --limit 100 \
    --state "open" \
    --updated "$SINCE_DATE"
fi >"$TMP/involves.json"

gh search issues \
    "$QUERY" \
    --include-prs \
    --json "repository,title,url,state,number,updatedAt" \
    --limit 100 \
    --state "open" \
    --updated "$SINCE_DATE" \
    >"$TMP/query.json"

gh search issues \
    "${QUERY#@}" \
    --include-prs \
    --json "repository,title,url,state,number,updatedAt" \
    --limit 100 \
    --state "open" \
    --updated "$SINCE_DATE" \
    >"$TMP/query-@.json"

gh search issues \
    "${QUERY%[bot]}" \
    --include-prs \
    --json "repository,title,url,state,number,updatedAt" \
    --limit 100 \
    --state "open" \
    --updated "$SINCE_DATE" \
    >"$TMP/query-[bot].json"

QUERY="${QUERY#@}"
QUERY="${QUERY%[bot]}"
gh search issues \
    "$QUERY" \
    --include-prs \
    --json "repository,title,url,state,number,updatedAt" \
    --limit 100 \
    --state "open" \
    --updated "$SINCE_DATE" \
    >"$TMP/query-@-[bot].json"

jq -s 'add | unique_by(.url)' "$TMP/involves.json" "$TMP/query.json" "$TMP/query-@.json" "$TMP/query-[bot].json" "$TMP/query-@-[bot].json"
